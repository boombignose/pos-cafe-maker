{
  "name": "pos-cafe-maker",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build && node scripts/copy-licenses.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:db": "tsx --test tests/db.test.ts",
    "models": "tsx scripts/export-models.ts",
    "setup": "tsx server/setup.ts",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:hardware": "python3 -m unittest discover -s tests -p 'hardware*_test.py'",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@jscad/modeling": "^2.12.6",
    "@jscad/stl-serializer": "^2.1.23",
    "express": "^5.1.0",
    "fflate": "^0.8.2",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
